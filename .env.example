# bc workspace secrets — DO NOT COMMIT
# Copy to .env and fill in your values.

# ─── bc core ────────────────────────────────────────────────────────
# MYCEL_HOME              Override default bc config directory (~/.bc)
# MYCEL_STATE_DIR         Override state/data directory (default: $MYCEL_HOME)
# MYCEL_WORKSPACE         Path to workspace root (set automatically for agents)
# MYCEL_BIN               Path to bc binary (default: bc in PATH)
# MYCEL_ROOT              Workspace root directory (used by TUI)
# MYCEL_HOST_WORKSPACE    Host-side workspace path for Docker volume mounts
# MYCEL_DAEMON_ADDR       Address of the bcd daemon (default: localhost:9374)
# MYCEL_DAEMON_ADDR          bcd server address for agent ↔ server communication

# ─── agent session (set automatically, do not override) ─────────────
# MYCEL_AGENT_ID          Current agent name
# MYCEL_AGENT_ROLE        Current agent role
# MYCEL_AGENT_RUNTIME     Runtime backend (tmux or docker)
# MYCEL_AGENT_TOOL        Agent's AI tool (claude, gemini, etc.)
# MYCEL_AGENT_WORKTREE    Path to agent's worktree
# MYCEL_WORKTREE_NAME     Worktree directory name
# MYCEL_PARENT_ID         Parent agent name (for sub-agents)

# ─── AI provider keys ──────────────────────────────────────────────
# Store these via `bc secret set` rather than in .env where possible.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── GitHub ─────────────────────────────────────────────────────────
# Required for agent operations (git push, PR creation, MCP servers).
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxxx

# ─── Database ───────────────────────────────────────────────────────
# DATABASE_URL          PostgreSQL DSN for persistent storage (optional)
# DATABASE_URL=postgres://bc:bc@localhost:5432/bc

# TimescaleDB stats backend (optional)
# STATS_DATABASE_URL=postgres://bc:bc@localhost:5433/bcstats

# ─── General / UI ──────────────────────────────────────────────────
# EDITOR               Preferred editor for `bc config edit` (default: vi)
# NO_COLOR=1           Disable colored output (respected by CLI and TUI)
# MYCEL_HIGH_CONTRAST=1   Enable high-contrast TUI colors
