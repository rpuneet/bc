# mycel-db — Unified database for mycel (relational + time-series)
# Uses TimescaleDB (which IS Postgres) for both relational data and hypertables.
# One container serves both workloads.
#
# Usage: docker build -t mycel-db:latest -f docker/Dockerfile.db .
#
# POSTGRES_PASSWORD must be set at runtime:
#   docker run -e POSTGRES_PASSWORD=secret mycel-db:latest
#   Or via mycel up (which sets POSTGRES_PASSWORD automatically)

FROM timescale/timescaledb:2.19.1-pg17

ENV POSTGRES_USER=mycel
ENV POSTGRES_DB=mycel
# POSTGRES_PASSWORD intentionally not set — must be provided at runtime.

# Init scripts run on first start (alphabetical order)
# Contains both relational tables AND TimescaleDB hypertables
COPY docker/db/init.sql /docker-entrypoint-initdb.d/01-init.sql

EXPOSE 5432
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD pg_isready -U mycel -d mycel || exit 1
